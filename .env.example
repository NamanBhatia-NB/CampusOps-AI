# =============================================
# CampusOps AI — Environment Variables
# Rename this file to .env and Docker will automatically load it.
# Keep this file secure and NEVER commit it to version control!
# =============================================

# --- Database Credentials ---
DB_USERNAME=campusops
DB_PASSWORD=secret_db_password
DB_NAME=campusops

# --- Admin Initial Setup ---
# The seeder will create this user on the first run.
ADMIN_EMAIL=admin@campusops.ai
ADMIN_PASSWORD=super_secure_password_123

# --- JWT Security ---
# Generate a secure 256-bit random string for this
JWT_SECRET=replace_this_with_a_very_long_secure_random_string_for_production

# --- Integrations (WhatsApp) ---
# Set provider to 'meta' to use the real adapter instead of 'mock'
WHATSAPP_PROVIDER=mock
META_WHATSAPP_TOKEN=your_meta_graph_api_access_token_here
META_PHONE_NUMBER_ID=your_whatsapp_business_phone_number_id_here

# --- Integrations (AI Insights) ---
# Set provider to 'gemini' or 'openai' instead of 'fallback'
AI_PROVIDER=fallback
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- Integrations (Google Sheets Worker) ---
# For maximum security, encode your credentials.json file to Base64 and paste it here
# (e.g., using `base64 credentials.json -w 0` on Linux/Mac, or an online tool)
GOOGLE_SHEETS_CREDENTIALS_B64=paste_your_base64_encoded_json_string_here
